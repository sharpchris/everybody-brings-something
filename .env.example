# Everybody Brings Something configuration. Copy to .env and fill in.
# docker compose reads .env automatically. For local development without Docker,
# use `uv run --env-file .env …` (Django doesn't load .env itself).

# --- Required -----------------------------------------------------------------

# Signs sessions and attendee cookies. Keep it secret; changing it signs everyone out.
# Generate one with either:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_urlsafe(40))"
SECRET_KEY=

# Visiting any page with ?admin=<ADMIN_KEY> unlocks admin mode. At least 20 characters.
# Leave empty to disable admin mode. Generate it the same way as SECRET_KEY
# (both commands give URL-safe keys; avoid base64, whose "+" breaks in a URL).
ADMIN_KEY=

# --- Address and HTTPS --------------------------------------------------------

# The address people use, e.g. https://signup.example.org or http://192.168.1.20:8000.
# Sets the allowed host and trusted CSRF origin. An https:// URL also turns on
# HTTPS-only cookies (and HSTS when BEHIND_PROXY=1). Leave empty to use only
# http://localhost:8000.
SITE_URL=

# Usually leave unset: HTTPS follows SITE_URL's scheme. Set 1 or 0 only to override it.
# HTTPS=0

# 1 if a reverse proxy terminates TLS and sets X-Forwarded-Proto. Only enable when
# the app is reachable solely through that proxy.
# BEHIND_PROXY=1

# Extra hostnames / origins, comma-separated, if the site answers on more than SITE_URL.
# ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=

# --- Other --------------------------------------------------------------------

# Default time zone for new installs. Admins can change it later under Site settings.
TIME_ZONE=America/New_York

LOG_LEVEL=INFO

# gunicorn worker processes (each runs 4 threads).
WEB_CONCURRENCY=2

# Abuse limits (defaults shown). Admin actions are never limited.
# MAX_CLAIMS_PER_ITEM=5             # signups per person on one unlimited item
# MAX_CUSTOM_ITEMS_PER_ATTENDEE=3   # "Bring something else" items per person per category
# NEW_ATTENDEES_PER_HOUR=30         # new attendee profiles per IP per hour

# DEBUG is off unless set. Use DEBUG=1 only for local development, never in production.
